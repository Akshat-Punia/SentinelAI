# Sentinel AI Environment Configuration

# Application
PROJECT_NAME="Sentinel AI"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# For SQLite (quick local dev): sqlite:///./sentinel.db
# For PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/sentinel_ai
DATABASE_URL="sqlite:///./sentinel.db"

# Groq GenAI Assistant (optional for Phase 1-5, required for Phase 6)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

